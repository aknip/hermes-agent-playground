{
	"name": "@kaneo/kaneo-client",
	"version": "0.1.0",
	"description": "Typed HTTP client for the public Kaneo API, shared by Kaneo's importers",
	"license": "MIT",
	"author": "Kaneo (https://kaneo.app)",
	"homepage": "https://kaneo.app/docs",
	"repository": {
		"type": "git",
		"url": "https://github.com/usekaneo/kaneo/",
		"directory": "packages/kaneo-client"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"kaneo",
		"api",
		"client",
		"import",
		"migration"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepublishOnly": "pnpm run build",
		"lint": "biome check --write .",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts"
	},
	"dependencies": {},
	"devDependencies": {
		"@kaneo/typescript-config": "workspace:*",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}